# Copie para .env e preencha. Sem DEMANDA_API_URL o catálogo roda com preços de demonstração.
PORT=3000

# Endereço base da API do sistema Demanda
DEMANDA_API_URL=
# Caminho do endpoint de preço; {codigo} vira o código do produto
DEMANDA_PRECO_PATH=/produtos/{codigo}/precos

# Autenticação (o token fica só no servidor, não vai para o navegador)
DEMANDA_API_TOKEN=
DEMANDA_AUTH_HEADER=Authorization
DEMANDA_AUTH_PREFIX="Bearer "
DEMANDA_TIMEOUT_MS=8000

# Nome dos campos na resposta JSON do Demanda (aceita caminhos como dados.preco_venda)
DEMANDA_CAMPO_PRECO=preco
DEMANDA_CAMPO_PRECO_PROMO=preco_promocional
DEMANDA_CAMPO_ESTOQUE=estoque
DEMANDA_CAMPO_PARCELAS=parcelas
# Lista de tabelas de preço: [{ "nome": "Varejo", "valor": 1999.90 }, ...]
DEMANDA_CAMPO_TABELAS=tabelas
DEMANDA_CAMPO_ATUALIZADO=atualizado_em

# Por quantos segundos guardar o preço em cache (0 = sempre consultar)
CACHE_SEGUNDOS=60
